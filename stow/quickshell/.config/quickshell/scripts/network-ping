#!/bin/bash
# Ping latency to a public probe, as a quick internet-reachability check.
set -euo pipefail

probe="1.1.1.1"

ms=$(LC_ALL=C ping -n -c 1 -W 1 "$probe" 2>/dev/null | awk -F'time[=<]' '/time[=<]/ { split($2, a, " "); print a[1]; exit }')

if [ -z "$ms" ]; then
  printf '{"label":"ping","text":"--","tooltip":"Ping (%s): timeout"}\n' "$probe"
else
  printf '{"label":"ping","text":"%.0fms","tooltip":"Ping (%s): %s ms"}\n' "$ms" "$probe" "$ms"
fi
