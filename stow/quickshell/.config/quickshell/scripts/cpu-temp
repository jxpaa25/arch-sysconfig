#!/bin/bash
# CPU package temperature via lm_sensors, with fallbacks for non-Intel chips
# and machines without a "Package id" sensor.
set -uo pipefail

raw=$(sensors 2>/dev/null | awk '/^Package id 0:/ {gsub(/[+°C]/, "", $4); print $4; exit}')

if [ -z "$raw" ]; then
  raw=$(sensors 2>/dev/null | awk '/^Tctl:/ {gsub(/[+°C]/, "", $2); print $2; exit}')
fi

if [ -z "$raw" ]; then
  raw=$(sensors 2>/dev/null | awk '{
    for (i = 1; i <= NF; i++) {
      if ($i ~ /^\+?[0-9]+(\.[0-9]+)?°C$/) {
        gsub(/[+°C]/, "", $i)
        print $i
        exit
      }
    }
  }')
fi

if [ -z "$raw" ]; then
  printf '{"label":"temp","text":"--","tooltip":"CPU temperature unavailable"}\n'
else
  printf '{"label":"temp","text":"%.0f°","tooltip":"CPU temperature: %s°C"}\n' "$raw" "$raw"
fi
