#!/bin/bash
# CPU usage %, measured as a delta over a short sample window.
set -euo pipefail

line1=$(grep '^cpu ' /proc/stat)
sleep 0.4
line2=$(grep '^cpu ' /proc/stat)

awk -v l1="$line1" -v l2="$line2" '
BEGIN {
  n1 = split(l1, f1, " ")
  n2 = split(l2, f2, " ")

  idle1 = f1[5] + f1[6]
  idle2 = f2[5] + f2[6]

  total1 = 0; total2 = 0
  for (i = 2; i <= n1; i++) total1 += f1[i]
  for (i = 2; i <= n2; i++) total2 += f2[i]

  dt = total2 - total1
  di = idle2 - idle1
  pct = (dt > 0) ? (100 * (dt - di) / dt) : 0

  printf "{\"label\":\"cpu\",\"text\":\"%.0f%%\",\"tooltip\":\"CPU usage: %.1f%%\"}\n", pct, pct
}'
