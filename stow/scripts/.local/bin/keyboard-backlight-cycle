#!/usr/bin/env bash
# Step the keyboard backlight through its levels, wrapping back to off.
# UNTESTED until it runs on real hardware; the VM has no backlight.
set -euo pipefail

device=$(brightnessctl --list --class=leds | sed -n "s/^Device '\(.*kbd_backlight.*\)'.*/\1/p" | head -n 1)
[[ -n $device ]] || exit 0
current=$(brightnessctl --device="$device" get)
max=$(brightnessctl --device="$device" max)
brightnessctl --device="$device" set $(((current + 1) % (max + 1))) >/dev/null
