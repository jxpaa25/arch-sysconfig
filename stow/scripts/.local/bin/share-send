#!/usr/bin/env bash
# Send the clipboard, a file or a folder to a nearby device with LocalSend.
# Files and folders are picked from your home directory in the menu.
# Usage: share-send clipboard|file|folder
set -euo pipefail

command -v localsend >/dev/null || {
  notify-send "Share" "LocalSend isn't installed"
  exit 1
}

case "${1:-}" in
  clipboard)
    path=$(mktemp --suffix=.txt)
    wl-paste >"$path"
    ;;
  file | folder)
    kind=f
    [[ $1 == folder ]] && kind=d
    relative=$(fd --type "$kind" --base-directory "$HOME" | menu-pick "Share a $1") || exit 0
    [[ -n $relative ]] || exit 0
    path="$HOME/$relative"
    ;;
  *)
    echo "Usage: share-send clipboard|file|folder" >&2
    exit 2
    ;;
esac

systemd-run --user --quiet --collect localsend --headless send "$path"
