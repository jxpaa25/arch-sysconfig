#!/usr/bin/env bash
# Switch the default audio output to the next available device.
set -euo pipefail

sinks=$(LC_ALL=C pactl -f json list sinks |
  jq -c '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]')
count=$(jq 'length' <<<"$sinks")
((count > 0)) || exit 1

current=$(jq -r --arg name "$(pactl get-default-sink)" 'map(.name) | index($name) // -1' <<<"$sinks")
next=$(jq -c ".[$(((current + 1) % count))]" <<<"$sinks")

pactl set-default-sink "$(jq -r '.name' <<<"$next")"
notify-send -u low "Audio output" "$(jq -r '.description // .name' <<<"$next")"
