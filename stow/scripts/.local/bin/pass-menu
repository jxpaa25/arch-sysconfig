#!/usr/bin/env bash
# Pick a `pass` entry from the menu and copy its password, clearing it after 45 seconds.
# It doesn't use `pass -c`, which would put the password in the clipboard history: copying
# with --sensitive tells the history to skip it.
shopt -s nullglob globstar

prefix=${PASSWORD_STORE_DIR:-$HOME/.password-store}
files=("$prefix"/**/*.gpg)
files=("${files[@]#"$prefix"/}")
files=("${files[@]%.gpg}")

((${#files[@]})) || {
  notify-send "pass" "No entries in $prefix"
  exit 1
}

entry=$(printf '%s\n' "${files[@]}" | menu-pick "Passwords") || exit 0
[[ -n $entry ]] || exit 0

# Only the first line is the password. A failed decrypt leaves nothing to copy.
password=$(pass show "$entry" 2>/dev/null | head -n 1)
if [[ -z $password ]]; then
  notify-send "pass" "Failed to decrypt $entry"
  exit 1
fi

printf '%s' "$password" | wl-copy --sensitive
fingerprint=$(printf '%s' "$password" | sha256sum)
unset password
notify-send "pass" "Copied $entry (clears in 45s)"

# Leave the clipboard alone if something else has been copied in the meantime.
sleep 45
if [[ $(wl-paste --no-newline 2>/dev/null | sha256sum) == "$fingerprint" ]]; then
  wl-copy --clear
fi
