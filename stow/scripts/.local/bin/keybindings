#!/usr/bin/env bash
# Search the keybindings of Hyprland, tmux or herdr in the menu.
# Usage: keybindings [hyprland|tmux|herdr]
set -euo pipefail

hyprland() {
  hyprctl binds -j | jq -r '
    def mods($m):
      [(if $m / 64 % 2 >= 1 then "SUPER" else empty end),
       (if $m / 4 % 2 >= 1 then "CTRL" else empty end),
       (if $m / 8 % 2 >= 1 then "ALT" else empty end),
       (if $m % 2 >= 1 then "SHIFT" else empty end)];
    .[] | select(.description != "")
    | (mods(.modmask | floor) + [.key]) as $keys
    | "\(.description)\t\($keys | join(" + "))"'
}

tmux_keys() {
  # The list needs a running server, and a server with no sessions exits straight away.
  tmux start-server \; list-keys -T prefix -N 2>/dev/null |
    sed -E 's/^(\S+)\s+/C-a \1\t/' | awk -F'\t' '{print $2 "\t" $1}'
}

herdr_keys() {
  awk -F' *= *' '
    /^\[/ { section = $0; gsub(/[][]/, "", section); next }
    section ~ /^keys/ && NF == 2 && $1 !~ /^#/ { gsub(/"/, "", $2); print $1 "\t" $2 }
  ' "${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"
}

case "${1:-hyprland}" in
  hyprland) hyprland | menu-pick "Hyprland keys" >/dev/null ;;
  tmux) tmux_keys | menu-pick "Tmux keys" >/dev/null ;;
  herdr) herdr_keys | menu-pick "Herdr keys" >/dev/null ;;
  *)
    echo "Usage: keybindings [hyprland|tmux|herdr]" >&2
    exit 2
    ;;
esac
