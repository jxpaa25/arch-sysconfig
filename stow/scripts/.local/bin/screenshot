#!/usr/bin/env bash
# Select a region or click a window, then save the screenshot and copy it to the clipboard.
# Usage: screenshot [region|fullscreen]
set -euo pipefail

dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

if [[ ${1:-region} == fullscreen ]]; then
  grim "$file"
else
  # Freeze the screen so the selection matches what gets captured.
  hyprpicker -r -z >/dev/null 2>&1 &
  freeze=$!
  trap 'kill "$freeze" 2>/dev/null || true' EXIT
  sleep 0.1

  workspace=$(hyprctl activeworkspace -j | jq -r '.id')
  geometry=$(hyprctl clients -j |
    jq -r --argjson ws "$workspace" '.[] | select(.workspace.id == $ws and (.hidden | not)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' |
    slurp) || exit 0
  grim -g "$geometry" "$file"
fi

wl-copy --type image/png <"$file"
notify-send -u low "Screenshot saved" "$file"
